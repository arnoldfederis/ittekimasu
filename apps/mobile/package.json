  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "dev": "expo start",
    "pods": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 pod install",
    "build:ios": "SENTRY_DISABLE_AUTO_UPLOAD=true xcodebuild -workspace ios/Ittekimasu.xcworkspace -scheme Ittekimasu -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -destination 'generic/platform=iOS Simulator' build",
    "lint": "biome check src",
    "format": "biome check --write src",
    "check-types": "tsc --noEmit",
    "pre:push": "biome check src && tsc --noEmit"
